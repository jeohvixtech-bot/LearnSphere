node_modules/
build/
dist/
coverage/
.DS_Store
*.log
.env*
!.env.example

# .NET build artifacts
backend/**/bin/
backend/**/obj/

# Local dev secrets (keep password out of git)
backend/**/appsettings.Development.json

# User-uploaded documents (may contain PII — ID photos, certificates)
backend/**/wwwroot/uploads/documents/
backend/**/wwwroot/uploads/profiles/

# Published output. A `dotnet publish` into the source tree was committed three levels
# deep once already; ignoring it stops that recurring.
publish/
*-publish.zip

# A second copy of the project lives here on one machine. It carries its own .git, so
# committing it would create an embedded repository that clones cannot fetch.
/LearnSphere/
